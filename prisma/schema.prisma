generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadLanguage {
  HI
  EN
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  BOOKED
  LOST
}

enum MessageSender {
  GUEST
  AGENT
  AI
}

enum AssetType {
  IMAGE
  VIDEO_LINK
  PDF
  INVOICE_LINK
  PAYMENT_LINK
  BROCHURE_LINK
  DOCUMENT_LINK
}

enum AssetCategory {
  ROOM
  EXPERIENCE
  PROPERTY
  WEDDING
  DINING
  BROCHURE
  INVOICE
  PAYMENT
  OTHER
}

enum ChannelKind {
  WHATSAPP
  WEBSITE
  EMAIL
  INSTAGRAM
  API
  VOICE
}

enum ChannelConnectionStatus {
  DRAFT
  CONNECTING
  CONNECTED
  DEGRADED
  DISABLED
  ERROR
}

enum ParticipantKind {
  CUSTOMER
  HUMAN
  BOT
  SYSTEM
}

enum ConversationStatus {
  OPEN
  BOT_ACTIVE
  HUMAN_OWNED
  RESOLVED
  CLOSED
}

enum NeutralMessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum BotCategory {
  BUSINESS_AI
  PINGBOOK
  FLOWCART
  STAY
  RESTAURANT
  REAL_ESTATE
  EDUCATION
  CUSTOM
}

enum BotOperatingMode {
  ANSWER_ONLY
  LEAD_CAPTURE
  APPROVED_ACTIONS
  HUMAN_APPROVAL
}

model Property {
  id                  String               @id @default(cuid())
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  slug                String               @unique
  city                String?
  state               String?
  timezone            String               @default("Asia/Kolkata")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leads               Lead[]
  metrics             MetricDaily[]
  campaigns           Campaign[]
  automationJobs      AutomationJob[]
  assets              Asset[]
  whatsappIntegration WhatsAppIntegration?
  appointmentTenants  AppointmentTenant[]
  commerceTenants     CommerceTenant[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeEntries    KnowledgeEntry[]
  knowledgeGaps       KnowledgeGap[]
  knowledgePreviews   KnowledgePreview[]
  knowledgeFlags      KnowledgeAnswerFlag[]
  channelConnections  ChannelConnection[]
  participants        Participant[]
  conversations       Conversation[]
  neutralMessages     Message[]
  aiOperations        AiOperation[]
  websiteSessions     WebsiteVisitorSession[]
  sovereignEvidence   SovereignAnswerEvidence[]
  answerFeedback      SovereignAnswerFeedback[]
  sovereignReplayCases SovereignReplayCase[]

  @@index([organizationId])
}

model KnowledgeDocument {
  id              String           @id @default(cuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  content         Bytes
  extractedText   String           @db.Text
  status          String           @default("PENDING")
  conflictSummary String?          @db.Text
  uploadedBy      String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         KnowledgeEntry[]

  @@index([propertyId, status])
}

model KnowledgeEntry {
  id              String             @id @default(cuid())
  propertyId      String
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  question        String             @db.Text
  answer          String             @db.Text
  category        String             @default("General")
  status          String             @default("DRAFT")
  conflictSummary String?            @db.Text
  claimKey        String?
  claimType       String             @default("FACT")
  valueType       String             @default("TEXT")
  currency        String?
  effectiveAt     DateTime?
  expiresAt       DateTime?
  refreshDays     Int                @default(90)
  reliability     String             @default("CLIENT_CONFIRMED")
  authorityLevel  String             @default("CLIENT_APPROVED_STRUCTURED")
  version         Int                @default(1)
  supersedesId    String?
  supersedes      KnowledgeEntry?    @relation("KnowledgeSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    KnowledgeEntry[]   @relation("KnowledgeSupersession")
  validationStatus String            @default("PENDING")
  validationErrors String[]          @default([])
  conflictStatus  String             @default("CLEAR")
  fieldApprovedBy String?
  fieldApprovedAt DateTime?
  previewApprovedBy String?
  previewApprovedAt DateTime?
  publishedAt     DateTime?
  pausedAt        DateTime?
  pauseReason     String?
  lastConfirmedAt DateTime?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resolvedGaps    KnowledgeGap[]
  previews        KnowledgePreview[]
  answerFlags     KnowledgeAnswerFlag[]

  @@index([propertyId, status])
  @@index([propertyId, claimKey, version])
  @@index([propertyId, expiresAt, status])
  @@index([supersedesId])
  @@index([documentId])
}

model KnowledgePreview {
  id              String         @id @default(cuid())
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entryId         String
  entry           KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  question        String         @db.Text
  generatedAnswer String         @db.Text
  status          String         @default("PENDING")
  generatedAt     DateTime       @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([propertyId, status, createdAt])
  @@index([entryId, status])
}

model KnowledgeAnswerFlag {
  id              String          @id @default(cuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entryId         String?
  entry           KnowledgeEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  evidenceId      String?
  reporterType    String          @default("CLIENT_ADMIN")
  reporterId      String?
  reason          String          @db.Text
  status          String          @default("OPEN")
  acknowledgeDueAt DateTime
  resolveDueAt    DateTime
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([propertyId, status, resolveDueAt])
  @@index([entryId, status])
  @@index([evidenceId])
}

model KnowledgeGap {
  id                 String          @id @default(cuid())
  propertyId         String
  property           Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  question           String          @db.Text
  normalizedQuestion String
  occurrenceCount    Int             @default(1)
  status             String          @default("OPEN")
  lastAskedAt        DateTime        @default(now())
  resolutionEntryId  String?
  resolutionEntry    KnowledgeEntry? @relation(fields: [resolutionEntryId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([propertyId, normalizedQuestion])
  @@index([propertyId, status, occurrenceCount])
}

model Organization {
  id                   String                    @id @default(cuid())
  name                 String
  slug                 String                    @unique
  industry             String?
  website              String?
  country              String                    @default("India")
  timezone             String                    @default("Asia/Kolkata")
  gstNumber            String?
  businessAddress      String?
  ownerName            String
  ownerEmail           String
  ownerMobile          String?
  publicPhone          String?
  publicEmail          String?
  publicAddress        String?
  publicBusinessHours  String?
  status               String                    @default("DRAFT")
  plan                 String                    @default("TRIAL")
  isDemo               Boolean                   @default(false)
  demoKey              String?                   @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  properties           Property[]
  members              OrganizationMember[]
  onboarding           OnboardingProfile?
  onboardingCredential OnboardingCredential?
  botConfiguration     WhatsAppBotConfiguration?
  botProfile           BotProfile?
  botConnectors        BotConnectorConfiguration[]
  demoSandbox          DemoSandbox?
  documents            OnboardingDocument[]
  activities           OnboardingActivity[]
  supportTickets       SupportTicket[]
  subscription         Subscription?
  invoices             BillingInvoice[]
  usageRecords         UsageRecord[]
  incidents            PlatformIncident[]
  auditLogs            PlatformAuditLog[]
  userSessions         UserSession[]

  @@index([ownerEmail])
  @@index([status])
}

model DemoSandbox {
  id              String               @id @default(cuid())
  organizationId  String               @unique
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         BotCategory
  fixtureVersion   String               @default("1.0")
  fixture           Json
  status            String               @default("READY")
  resetCount        Int                  @default(0)
  lastResetAt       DateTime?
  lastResetBy       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  connectorEvents   DemoConnectorEvent[]

  @@index([category, status])
}

model DemoConnectorEvent {
  id              String      @id @default(cuid())
  demoSandboxId   String
  demoSandbox     DemoSandbox @relation(fields: [demoSandboxId], references: [id], onDelete: Cascade)
  connectorKey    String
  operation       String
  idempotencyKey  String
  status          String
  request         Json
  response        Json
  createdAt       DateTime    @default(now())

  @@unique([demoSandboxId, idempotencyKey])
  @@index([demoSandboxId, createdAt])
  @@index([connectorKey, status])
}

model UserSession {
  id             String        @id @default(cuid())
  sessionId      String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  authSource     String        @default("local")
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?

  @@index([email, revokedAt, expiresAt])
  @@index([organizationId, revokedAt])
}

model WhatsAppBotConfiguration {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled             Boolean      @default(true)
  language            String       @default("EN")
  welcomeEnabled      Boolean      @default(true)
  welcomeMessage      String       @db.Text
  serviceBuckets      String[]
  auditEnabled        Boolean      @default(true)
  trialEnabled        Boolean      @default(true)
  humanHandoffEnabled Boolean      @default(true)
  collectLeadDetails  Boolean      @default(true)
  updatedBy           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model BotProfile {
  id                   String           @id @default(cuid())
  organizationId       String           @unique
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             BotCategory      @default(BUSINESS_AI)
  personaPackVersion   String           @default("1.0")
  operatingMode        BotOperatingMode @default(LEAD_CAPTURE)
  channels             ChannelKind[]    @default([WEBSITE])
  capabilities         String[]         @default(["ANSWER_QUESTIONS", "CAPTURE_LEADS"])
  humanHandoffEnabled  Boolean          @default(true)
  actionApprovalNeeded Boolean          @default(true)
  personaName          String?
  businessObjective    String?          @db.Text
  tone                  String           @default("Professional, clear and helpful")
  languages             String[]         @default(["English"])
  prohibitedClaims      String[]         @default([])
  escalationTriggers    String[]         @default([])
  responseSlaMinutes    Int              @default(60)
  reminderPercent       Int              @default(50)
  fallbackEnabled       Boolean          @default(false)
  safeFallbackMessage   String?          @db.Text
  kbGateVersion         String?
  kbCoverageMinimum     Int              @default(80)
  status               String           @default("DRAFT")
  installationKey      String?          @unique
  installationDetectedAt DateTime?
  liveAt               DateTime?
  pausedAt             DateTime?
  deletedAt            DateTime?
  lifecycleUpdatedBy   String?
  configuredBy         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model BotConnectorConfiguration {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorKey        String
  name                String
  provider            String?
  requiredFor         String
  required            Boolean      @default(false)
  enabled             Boolean      @default(false)
  lifecycle           String       @default("REQUESTED")
  readOperations      String[]     @default([])
  writeOperations     String[]     @default([])
  unavailableBehavior String       @db.Text
  lastVerifiedAt      DateTime?
  configuredBy        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, connectorKey])
  @@index([organizationId, lifecycle])
  @@index([organizationId, required, enabled])
}

model OrganizationMember {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String
  name                String?
  role                String       @default("OWNER")
  status              String       @default("ACTIVE")
  passwordHash        String?
  invitationTokenHash String?      @unique
  invitationExpiresAt DateTime?
  invitedBy           String?
  invitedAt           DateTime     @default(now())
  joinedAt            DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([email, status])
}

model OnboardingProfile {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentStep             Int          @default(1)
  progressPercent         Int          @default(10)
  lifecycleStatus         String       @default("DRAFT")
  legalName               String?
  registrationNumber      String?
  facebookPage            String?
  googleMapsUrl           String?
  googleBusinessProfileUrl String?
  instagramUrl            String?
  photoUrls               String[]     @default([])
  businessCategory        String?
  logoUrl                 String?
  kycStatus               String       @default("NOT_SUBMITTED")
  kycSubmittedAt          DateTime?
  kycReviewedAt           DateTime?
  kycReviewedBy           String?
  kycRejectionReason      String?
  phoneCountryCode        String       @default("+91")
  phoneNumber             String?
  whatsappActiveOnNumber  Boolean?
  numberConnectionPath    String?
  phoneVerificationStatus String       @default("NOT_STARTED")
  facebookStatus          String       @default("NOT_CONNECTED")
  metaStatus              String       @default("NOT_STARTED")
  metaBusinessId          String?
  wabaId                  String?
  phoneNumberId           String?
  displayPhoneNumber      String?
  qualityRating           String?
  webhookStatus           String       @default("NOT_CONFIGURED")
  tokenStatus             String       @default("NOT_CONFIGURED")
  metaBillingStatus       String       @default("NOT_CONFIRMED")
  templateStatus          String       @default("NOT_STARTED")
  firstMessageStatus      String       @default("NOT_STARTED")
  lastStatusCheckAt       DateTime?
  lastError               String?
  completedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([lifecycleStatus])
  @@index([kycStatus])
  @@index([metaStatus])
}

model OnboardingCredential {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrationPin String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OnboardingDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  fileName       String
  mimeType       String
  sizeBytes      Int
  content        Bytes
  status         String       @default("UPLOADED")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, type])
}

model OnboardingActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorEmail     String?
  action         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Lead {
  id             String           @id @default(cuid())
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  initials       String
  score          Int
  source         String
  stage          LeadStage
  language       LeadLanguage     @default(EN)
  intent         String
  stayLabel      String
  partyLabel     String
  budgetLabel    String
  phone          String
  lastActivityAt DateTime         @default(now())
  isHighPriority Boolean          @default(false)
  tags           LeadTag[]
  messages       LeadMessage[]
  assetShares    LeadAssetShare[]
  conversations  Conversation[]
  aiOperations   AiOperation[]
  websiteSession WebsiteVisitorSession?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([propertyId, phone])
  @@index([propertyId, stage])
  @@index([propertyId, score])
}

model WebsiteVisitorSession {
  id                 String    @id @default(cuid())
  propertyId         String
  property           Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId             String    @unique
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sessionIdHash      String
  capabilityHash     String    @unique
  status             String    @default("AI_READY")
  contactName        String?
  contactValue       String?
  consentText        String?   @db.Text
  consentedAt        DateTime?
  expiresAt          DateTime
  lastDeliveredAt    DateTime?
  lastReadAt         DateTime?
  resolutionState    Json?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([propertyId, sessionIdHash])
  @@index([propertyId, status, updatedAt])
  @@index([expiresAt, revokedAt])
}

model SovereignAnswerEvidence {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId              String?
  sessionIdHash       String
  constitutionVersion String
  blueprintVersion    String
  intent              String
  disposition         String
  contextUsed         Boolean  @default(false)
  confidence          Float    @default(0)
  safetyClassification String  @default("STANDARD")
  permittedOperation  String   @default("ANSWER")
  observedBehavior    String   @default("UNKNOWN")
  decisionConsistent  Boolean  @default(false)
  consistencyReason   String?  @db.Text
  resolutionState     String   @default("RESOLVED")
  clarifyCount        Int      @default(0)
  circuitBreaker      Boolean  @default(false)
  circuitBreakerReason String?
  evaluationVersion   String   @default("1.1")
  decisionReason      String   @db.Text
  question            String   @db.Text
  resolvedQuestion    String   @db.Text
  answer              String   @db.Text
  grounded            Boolean  @default(false)
  model               String
  sources             Json
  knowledgeAsOf       DateTime?
  knowledgeClaimIds   String[] @default([])
  personaCategory     String   @default("UNKNOWN")
  personaVersion      String   @default("UNKNOWN")
  retrievalCandidates Json     @default("[]")
  retrievedClaimIds   String[] @default([])
  usedClaimIds        String[] @default([])
  nearMissClaimIds    String[] @default([])
  failureClassification String @default("NONE")
  safeResolution      Boolean  @default(false)
  evidencePipelineVersion String @default("1.0")
  failureLayer        String   @default("NONE")
  failureCode         String?
  latencyMs           Int      @default(0)
  attemptCount        Int      @default(0)
  escalationTier      String   @default("TIER_0_SELF_RESOLVE")
  degradedMode        Boolean  @default(false)
  createdAt           DateTime @default(now())
  feedback            SovereignAnswerFeedback?
  replayCase          SovereignReplayCase?

  @@index([propertyId, createdAt])
  @@index([propertyId, intent, disposition])
  @@index([propertyId, decisionConsistent, createdAt])
  @@index([propertyId, circuitBreaker, createdAt])
  @@index([propertyId, failureLayer, createdAt])
  @@index([propertyId, escalationTier, createdAt])
  @@index([personaCategory, safeResolution, createdAt])
  @@index([propertyId, failureClassification, createdAt])
  @@index([leadId, createdAt])
}

model SovereignAnswerFeedback {
  id           String                  @id @default(cuid())
  propertyId   String
  property     Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  evidenceId   String                  @unique
  evidence     SovereignAnswerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  leadId       String?
  helpful      Boolean
  reason       String?                 @db.Text
  source       String                  @default("WEBSITE_WIDGET")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([propertyId, helpful, createdAt])
  @@index([leadId, createdAt])
}

model SovereignReplayCase {
  id                    String                  @id @default(cuid())
  propertyId            String
  property              Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceEvidenceId      String                  @unique
  sourceEvidence        SovereignAnswerEvidence @relation(fields: [sourceEvidenceId], references: [id], onDelete: Cascade)
  personaCategory       String
  personaVersion        String
  anonymizedQuestion    String                  @db.Text
  anonymizedPriorTurns  Json                    @default("[]")
  expectedDisposition   String
  expectedClaimIds      String[]                @default([])
  failureClassification String
  status                String                  @default("PENDING_REVIEW")
  anonymizationVersion  String                  @default("1.0")
  createdAt             DateTime                @default(now())
  reviewedAt            DateTime?

  @@index([propertyId, status, createdAt])
  @@index([personaCategory, status, createdAt])
}

model LeadTag {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())
}

model LeadMessage {
  id                String        @id @default(cuid())
  leadId            String
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender            MessageSender
  body              String
  externalMessageId String?       @unique
  deliveryStatus    String?
  statusUpdatedAt   DateTime?
  sentAt            DateTime
  createdAt         DateTime      @default(now())
  neutralMessage    Message?

  @@index([leadId, sentAt])
}

model ChannelConnection {
  id                   String                  @id @default(cuid())
  propertyId           String
  property             Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind                 ChannelKind
  externalId           String?
  displayName          String?
  status               ChannelConnectionStatus @default(DRAFT)
  enabled              Boolean                 @default(false)
  configuration        Json?
  credentialsReference String?
  lastHealthyAt        DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  conversations        Conversation[]

  @@unique([propertyId, kind, externalId])
  @@index([propertyId, kind, enabled])
  @@index([status, lastHealthyAt])
}

model Participant {
  id            String                    @id @default(cuid())
  propertyId    String
  property      Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind          ParticipantKind           @default(CUSTOMER)
  externalKey   String
  displayName   String?
  phone         String?
  email         String?
  metadata      Json?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  conversations ConversationParticipant[]
  sentMessages  Message[]

  @@unique([propertyId, kind, externalKey])
  @@index([propertyId, phone])
  @@index([propertyId, email])
}

model Conversation {
  id                     String                    @id @default(cuid())
  propertyId             String
  property               Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelConnectionId    String?
  channelConnection      ChannelConnection?        @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  legacyLeadId           String?
  legacyLead             Lead?                     @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  externalConversationId String?
  status                 ConversationStatus        @default(OPEN)
  botPaused              Boolean                   @default(false)
  humanOwnerEmail        String?
  lastMessageAt          DateTime                  @default(now())
  metadata               Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  participants           ConversationParticipant[]
  messages               Message[]

  @@unique([channelConnectionId, externalConversationId])
  @@index([propertyId, status, lastMessageAt])
  @@index([legacyLeadId])
  @@index([humanOwnerEmail, status])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
