generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadLanguage {
  HI
  EN
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  BOOKED
  LOST
}

enum MessageSender {
  GUEST
  AGENT
  AI
}

enum AssetType {
  IMAGE
  VIDEO_LINK
  PDF
  INVOICE_LINK
  PAYMENT_LINK
  BROCHURE_LINK
  DOCUMENT_LINK
}

enum AssetCategory {
  ROOM
  EXPERIENCE
  PROPERTY
  WEDDING
  DINING
  BROCHURE
  INVOICE
  PAYMENT
  OTHER
}

model Property {
  id          String      @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name        String
  slug        String      @unique
  city        String?
  state       String?
  timezone    String      @default("Asia/Kolkata")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  leads       Lead[]
  metrics     MetricDaily[]
  campaigns   Campaign[]
  automationJobs AutomationJob[]
  assets      Asset[]
  whatsappIntegration WhatsAppIntegration?
  knowledgeDocuments KnowledgeDocument[]
  knowledgeEntries KnowledgeEntry[]
  knowledgeGaps KnowledgeGap[]

  @@index([organizationId])
}

model KnowledgeDocument {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  content         Bytes
  extractedText   String    @db.Text
  status          String    @default("PENDING")
  conflictSummary String?   @db.Text
  uploadedBy      String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  entries         KnowledgeEntry[]

  @@index([propertyId, status])
}

model KnowledgeEntry {
  id              String             @id @default(cuid())
  propertyId      String
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentId      String?
  document        KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  question        String             @db.Text
  answer          String             @db.Text
  category        String             @default("General")
  status          String             @default("DRAFT")
  conflictSummary String?            @db.Text
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resolvedGaps    KnowledgeGap[]

  @@index([propertyId, status])
  @@index([documentId])
}

model KnowledgeGap {
  id                String         @id @default(cuid())
  propertyId        String
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  question          String         @db.Text
  normalizedQuestion String
  occurrenceCount   Int            @default(1)
  status            String         @default("OPEN")
  lastAskedAt       DateTime       @default(now())
  resolutionEntryId String?
  resolutionEntry   KnowledgeEntry? @relation(fields: [resolutionEntryId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([propertyId, normalizedQuestion])
  @@index([propertyId, status, occurrenceCount])
}

model Organization {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  industry        String?
  website         String?
  country         String                 @default("India")
  timezone        String                 @default("Asia/Kolkata")
  gstNumber       String?
  businessAddress String?
  ownerName       String
  ownerEmail      String
  ownerMobile     String?
  status          String                 @default("DRAFT")
  plan            String                 @default("TRIAL")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  properties      Property[]
  members         OrganizationMember[]
  onboarding      OnboardingProfile?
  onboardingCredential OnboardingCredential?
  botConfiguration WhatsAppBotConfiguration?
  documents       OnboardingDocument[]
  activities      OnboardingActivity[]
  supportTickets  SupportTicket[]
  subscription    Subscription?
  invoices        BillingInvoice[]
  usageRecords    UsageRecord[]
  incidents       PlatformIncident[]
  auditLogs       PlatformAuditLog[]
  userSessions    UserSession[]

  @@index([ownerEmail])
  @@index([status])
}

model UserSession {
  id             String        @id @default(cuid())
  sessionId      String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  authSource     String        @default("local")
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?

  @@index([email, revokedAt, expiresAt])
  @@index([organizationId, revokedAt])
}

model WhatsAppBotConfiguration {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled                Boolean      @default(true)
  language               String       @default("EN")
  welcomeEnabled         Boolean      @default(true)
  welcomeMessage         String       @db.Text
  serviceBuckets         String[]
  auditEnabled           Boolean      @default(true)
  trialEnabled           Boolean      @default(true)
  humanHandoffEnabled    Boolean      @default(true)
  collectLeadDetails     Boolean      @default(true)
  updatedBy              String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  role           String       @default("OWNER")
  status         String       @default("ACTIVE")
  passwordHash   String?
  invitationTokenHash String? @unique
  invitationExpiresAt DateTime?
  invitedBy      String?
  invitedAt      DateTime     @default(now())
  joinedAt       DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([email, status])
}

model OnboardingProfile {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentStep              Int          @default(1)
  progressPercent          Int          @default(10)
  lifecycleStatus          String       @default("DRAFT")
  legalName                String?
  registrationNumber      String?
  facebookPage             String?
  businessCategory        String?
  logoUrl                  String?
  kycStatus                String       @default("NOT_SUBMITTED")
  kycSubmittedAt           DateTime?
  kycReviewedAt            DateTime?
  kycReviewedBy            String?
  kycRejectionReason       String?
  phoneCountryCode        String       @default("+91")
  phoneNumber              String?
  whatsappActiveOnNumber  Boolean?
  numberConnectionPath    String?
  phoneVerificationStatus String       @default("NOT_STARTED")
  facebookStatus          String       @default("NOT_CONNECTED")
  metaStatus              String       @default("NOT_STARTED")
  metaBusinessId          String?
  wabaId                   String?
  phoneNumberId           String?
  displayPhoneNumber      String?
  qualityRating           String?
  webhookStatus           String       @default("NOT_CONFIGURED")
  tokenStatus             String       @default("NOT_CONFIGURED")
  metaBillingStatus       String       @default("NOT_CONFIRMED")
  templateStatus          String       @default("NOT_STARTED")
  firstMessageStatus      String       @default("NOT_STARTED")
  lastStatusCheckAt       DateTime?
  lastError               String?
  completedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([lifecycleStatus])
  @@index([kycStatus])
  @@index([metaStatus])
}

model OnboardingCredential {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrationPin String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OnboardingDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  fileName       String
  mimeType       String
  sizeBytes      Int
  content        Bytes
  status         String       @default("UPLOADED")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, type])
}

model OnboardingActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorEmail     String?
  action         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Lead {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  initials        String
  score           Int
  source          String
  stage           LeadStage
  language        LeadLanguage  @default(EN)
  intent          String
  stayLabel       String
  partyLabel      String
  budgetLabel     String
  phone           String
  lastActivityAt  DateTime      @default(now())
  isHighPriority  Boolean       @default(false)
  tags            LeadTag[]
  messages        LeadMessage[]
  assetShares     LeadAssetShare[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([propertyId, stage])
  @@index([propertyId, score])
  @@unique([propertyId, phone])
}

model LeadTag {
  id        String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value      String
  createdAt  DateTime @default(now())
}

model LeadMessage {
  id                String        @id @default(cuid())
  leadId            String
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender            MessageSender
  body              String
  externalMessageId String?       @unique
  deliveryStatus    String?
  statusUpdatedAt   DateTime?
  sentAt            DateTime
  createdAt         DateTime      @default(now())

  @@index([leadId, sentAt])
}

model MetricDaily {
  id                    String   @id @default(cuid())
  propertyId            String
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date                  DateTime
  totalLeads            Int      @default(0)
  confirmedRevenue      Int      @default(0)
  otaCommissionSaved    Int      @default(0)
  averageLeadScore      Float    @default(0)
  highScoreLeadCount    Int      @default(0)
  confirmedBookings     Int      @default(0)
  directGuestsAcquired  Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model Campaign {
  id                 String   @id @default(cuid())
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name               String
  festivalName       String   @default("")
  templateName       String?
  languageCode       String   @default("en_US")
  messageType        String   @default("TEMPLATE")
  metaChargeCategory String?
  scheduledFor       DateTime?
  estimatedReach     Int      @default(0)
  estimatedRevenue   Int      @default(0)
  estimatedCostPaisa Int      @default(0)
  requestedCount     Int      @default(0)
  sentCount          Int      @default(0)
  deliveredCount     Int      @default(0)
  readCount          Int      @default(0)
  failedCount        Int      @default(0)
  templateStatus     String   @default("UNKNOWN")
  consentSource      String?
  consentProof       String?  @db.Text
  consentConfirmedAt DateTime?
  consentConfirmedBy String?
  audienceSnapshot   String?  @db.Text
  testMode           Boolean  @default(false)
  createdBy          String?
  errorSummary       String?
  status             String   @default("DRAFT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recipients         CampaignRecipient[]

  @@index([propertyId, createdAt])
  @@index([status])
}

model CampaignRecipient {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone             String
  status            String   @default("QUEUED")
  externalMessageId String?  @unique
  error             String?
  consentStatus     String   @default("UNVERIFIED")
  consentSource     String?
  consentProof      String?  @db.Text
  suppressionReason String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, status])
}

model BillingPlan {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  description      String?
  billingInterval  String         @default("QUARTERLY")
  amountPaisa      Int            @default(0)
  currency         String         @default("INR")
  trialDays        Int            @default(0)
  limits           Json
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                    String           @id @default(cuid())
  organizationId        String           @unique
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                String
  plan                  BillingPlan      @relation(fields: [planId], references: [id])
  status                String           @default("TRIALING")
  paymentProvider       String           @default("MANUAL")
  externalSubscriptionId String?
  startedAt             DateTime         @default(now())
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime         @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean          @default(false)
  graceEndsAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  invoices              BillingInvoice[]

  @@index([status, currentPeriodEnd])
  @@index([planId])
}

model BillingInvoice {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber         String        @unique
  status                String        @default("DRAFT")
  currency              String        @default("INR")
  periodStart           DateTime
  periodEnd             DateTime
  platformFeePaisa      Int           @default(0)
  metaChargesPaisa      Int           @default(0)
  aiOveragePaisa        Int           @default(0)
  servicesPaisa         Int           @default(0)
  taxPaisa              Int           @default(0)
  adjustmentPaisa       Int           @default(0)
  totalPaisa            Int           @default(0)
  dueAt                 DateTime?
  paidAt                DateTime?
  paymentReference      String?
  notes                 String?       @db.Text
  createdBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([dueAt, status])
}

model UsageRecord {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric          String
  quantity        Int          @default(0)
  unit            String       @default("COUNT")
  periodStart     DateTime
  periodEnd       DateTime
  sourceRef       String?
  idempotencyKey  String       @unique
  recordedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([organizationId, metric, periodStart])
}

model PlatformIncident {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  severity        String        @default("MEDIUM")
  status          String        @default("OPEN")
  category        String
  title           String
  description     String        @db.Text
  ownerEmail      String?
  startedAt       DateTime      @default(now())
  resolvedAt      DateTime?
  resolution      String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, severity])
  @@index([organizationId, status])
}

model PlatformAuditLog {
  id              String        @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorEmail      String
  actorRole       String
  action          String
  targetType      String
  targetId        String?
  summary         String        @db.Text
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
}

model AutomationJob {
  id                String   @id @default(cuid())
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  workflowId        String
  workflowVersion   Int      @default(1)
  triggerType       String
  triggerRef        String?
  actionType        String
  status            String   @default("QUEUED")
  priority          Int      @default(5)
  payload           Json
  result            Json?
  idempotencyKey    String   @unique
  scheduledFor      DateTime @default(now())
  nextRunAt         DateTime @default(now())
  maxAttempts       Int      @default(3)
  attemptCount      Int      @default(0)
  lockedAt          DateTime?
  lockedBy          String?
  leaseExpiresAt    DateTime?
  lastError         String?  @db.Text
  deadLetterReason  String?  @db.Text
  createdBy         String?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertyId, status, nextRunAt])
  @@index([workflowId, status])
  @@index([leaseExpiresAt])
}

model SupportTicket {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference        String       @unique
  subject          String
  category         String
  priority         String       @default("NORMAL")
  status           String       @default("OPEN")
  description      String       @db.Text
  createdByEmail   String
  assignedToEmail  String?
  resolution       String?      @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  messages         SupportTicketMessage[]

  @@index([organizationId, status])
  @@index([status, priority])
  @@index([createdAt])
}

model SupportTicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String
  authorRole  String
  body        String        @db.Text
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Asset {
  id            String        @id @default(cuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           AssetType
  category       AssetCategory
  url            String
  thumbnailUrl   String?
  tags           String[]
  isActive       Boolean       @default(true)
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  shares         LeadAssetShare[]

  @@index([propertyId, category])
  @@index([propertyId, type])
}

model LeadAssetShare {
  id          String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channel      String    @default("WHATSAPP")
  note         String?
  sharedBy     String?
  sharedAt     DateTime  @default(now())
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([leadId, sharedAt])
  @@index([assetId, sharedAt])
}

model WhatsAppIntegration {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider            String   @default("META_CLOUD_API")
  businessAccountId   String?
  phoneNumberId       String?
  displayPhoneNumber  String?
  webhookVerifyToken  String?
  accessToken         String?
  status              String   @default("DISCONNECTED")
  approvedBy          String?
  approvedAt          DateTime?
  lastValidatedAt     DateTime?
  notes               String?
  aiModeEnabled       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
