generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// P2-A v6 additive knowledge authority. This file is a complete proposed
// schema and is validated independently; it is not the active schema.
model KnowledgeClaimIdentity {
  id                String                      @id @default(cuid())
  propertyId        String
  property          Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  stableKey         String
  entityKey         String
  fieldKey          String
  qualifiers        Json
  keyVersion        Int
  createdAt         DateTime                    @default(now())
  entries           KnowledgeEntry[]
  publicationClaims KnowledgePublicationClaim[]

  @@unique([propertyId, stableKey])
  @@unique([propertyId, id])
  @@index([propertyId, entityKey, fieldKey])
}

model KnowledgeSource {
  id                    String                     @id @default(cuid())
  propertyId            String
  property              Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sourceType            KnowledgeSourceType
  canonicalIdentity     String                     @db.Text
  canonicalIdentityHash String
  state                 KnowledgeSourceState       @default(DRAFT)
  audienceCeiling       KnowledgeAudience
  currentRevision       Int                        @default(0)
  revokedAt             DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  revisions             KnowledgeSourceRevision[]
  captures              SourceCapture[]
  consents              WebsiteSourceConsent[]
  objectReferences      KnowledgeObjectReference[]

  @@unique([propertyId, sourceType, canonicalIdentityHash])
  @@unique([propertyId, id])
  @@index([propertyId, state])
}

model KnowledgeSourceRevision {
  id                String               @id @default(cuid())
  propertyId        String
  sourceId          String
  revision          Int
  configuration     Json
  configurationHash String
  consentId         String
  createdBy         String
  createdAt         DateTime             @default(now())
  source            KnowledgeSource      @relation(fields: [propertyId, sourceId], references: [propertyId, id], onDelete: Restrict)
  consent           WebsiteSourceConsent @relation(fields: [propertyId, consentId], references: [propertyId, id], onDelete: Restrict)
  captures          SourceCapture[]

  @@unique([propertyId, sourceId, revision])
  @@unique([propertyId, sourceId, id])
  @@unique([propertyId, id])
}

model SourceCapture {
  id                  String                  @id @default(cuid())
  propertyId          String
  sourceId            String
  sourceRevisionId    String
  requestedGeneration BigInt
  operationKey        String                  @unique
  status              CaptureState            @default(QUEUED)
  requestedAt         DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  source              KnowledgeSource         @relation(fields: [propertyId, sourceId], references: [propertyId, id], onDelete: Restrict)
  sourceRevision      KnowledgeSourceRevision @relation(fields: [propertyId, sourceId, sourceRevisionId], references: [propertyId, sourceId, id], onDelete: Restrict)
  versions            CaptureVersion[]

  @@unique([propertyId, sourceId, requestedGeneration])
  @@unique([propertyId, id])
}

model KnowledgeObject {
  id               String                     @id @default(cuid())
  propertyId       String
  property         Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  storageNamespace String
  objectKey        String
  checksum         String
  byteSize         BigInt
  mediaType        String
  state            KnowledgeObjectState       @default(STAGED)
  stagingTokenHash String
  finalizedByJobId String?
  finalizedFence   BigInt?
  retainUntil      DateTime?
  legalHold        Boolean                    @default(false)
  createdAt        DateTime                   @default(now())
  usableAt         DateTime?
  finalizedByJob   AutomationJob?             @relation(fields: [propertyId, finalizedByJobId], references: [propertyId, id], onDelete: Restrict)
  references       KnowledgeObjectReference[]
  captureVersions  CaptureVersion[]

  @@unique([propertyId, objectKey])
  @@unique([propertyId, checksum])
  @@unique([propertyId, id])
  @@index([propertyId, state, createdAt])
}

model KnowledgeObjectReference {
  id                 String                       @id @default(cuid())
  propertyId         String
  objectId           String
  sourceId           String
  purpose            String
  retainUntil        DateTime?
  legalHold          Boolean                      @default(false)
  releasedAt         DateTime?
  createdAt          DateTime                     @default(now())
  object             KnowledgeObject              @relation(fields: [propertyId, objectId], references: [propertyId, id], onDelete: Restrict)
  source             KnowledgeSource              @relation(fields: [propertyId, sourceId], references: [propertyId, id], onDelete: Restrict)
  retentionDecisions KnowledgeRetentionDecision[]

  @@unique([propertyId, objectId, sourceId, purpose])
  @@unique([propertyId, id])
}

model CaptureVersion {
  id             String                   @id @default(cuid())
  propertyId     String
  captureId      String
  objectId       String
  checksum       String
  manifest       Json
  capturedAt     DateTime
  createdAt      DateTime                 @default(now())
  capture        SourceCapture            @relation(fields: [propertyId, captureId], references: [propertyId, id], onDelete: Restrict)
  object         KnowledgeObject          @relation(fields: [propertyId, objectId], references: [propertyId, id], onDelete: Restrict)
  extractionRuns KnowledgeExtractionRun[]
  evidence       KnowledgeClaimEvidence[]

  @@unique([propertyId, captureId, checksum])
  @@unique([propertyId, id])
}

model KnowledgeExtractionRun {
  id                   String         @id @default(cuid())
  propertyId           String
  captureVersionId     String
  extractorVersion     String
  normalizationVersion String
  operationKey         String         @unique
  status               CaptureState   @default(QUEUED)
  resultManifestHash   String?
  createdAt            DateTime       @default(now())
  completedAt          DateTime?
  captureVersion       CaptureVersion @relation(fields: [propertyId, captureVersionId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, captureVersionId, extractorVersion, normalizationVersion])
  @@unique([propertyId, id])
}

model KnowledgeClaimEvidence {
  id                  String                             @id @default(cuid())
  propertyId          String
  entryId             String
  captureVersionId    String
  locator             Json
  locatorHash         String
  quotation           String                             @db.Text
  quotationHash       String
  supportedComponents String[]
  bindingHash         String
  createdAt           DateTime                           @default(now())
  entry               KnowledgeEntry                     @relation(fields: [propertyId, entryId], references: [propertyId, id], onDelete: Restrict)
  captureVersion      CaptureVersion                     @relation(fields: [propertyId, captureVersionId], references: [propertyId, id], onDelete: Restrict)
  bindings            KnowledgeRevisionEvidenceBinding[]

  @@unique([propertyId, entryId, captureVersionId, locatorHash])
  @@unique([propertyId, entryId, id])
  @@unique([propertyId, id])
}

model KnowledgeRevisionEvidenceBinding {
  id          String                 @id @default(cuid())
  propertyId  String
  entryId     String
  evidenceId  String
  bindingHash String
  createdAt   DateTime               @default(now())
  entry       KnowledgeEntry         @relation(fields: [propertyId, entryId], references: [propertyId, id], onDelete: Restrict)
  evidence    KnowledgeClaimEvidence @relation(fields: [propertyId, entryId, evidenceId], references: [propertyId, entryId, id], onDelete: Restrict)

  @@unique([propertyId, entryId, evidenceId])
  @@unique([propertyId, entryId, bindingHash])
}

model KnowledgeClaimConflict {
  id            String         @id @default(cuid())
  propertyId    String
  lowerEntryId  String
  higherEntryId String
  reason        String         @db.Text
  blocking      Boolean        @default(true)
  resolvedAt    DateTime?
  resolvedBy    String?
  resolution    String?        @db.Text
  createdAt     DateTime       @default(now())
  lowerEntry    KnowledgeEntry @relation("ConflictLower", fields: [propertyId, lowerEntryId], references: [propertyId, id], onDelete: Restrict)
  higherEntry   KnowledgeEntry @relation("ConflictHigher", fields: [propertyId, higherEntryId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, lowerEntryId, higherEntryId])
  @@unique([propertyId, id])
}

model KnowledgeApprovalEvidence {
  id             String                      @id @default(cuid())
  propertyId     String
  purpose        ApprovalPurpose
  decision       ApprovalDecision
  scopeManifest  Json
  scopeHash      String
  audience       KnowledgeAudience?
  policyVersion  String
  actorId        String
  actorEmailHash String
  authority      String
  supersedesId   String?
  decidedAt      DateTime                    @default(now())
  supersedes     KnowledgeApprovalEvidence?  @relation("ApprovalSupersession", fields: [propertyId, supersedesId], references: [propertyId, id], onDelete: Restrict)
  supersededBy   KnowledgeApprovalEvidence[] @relation("ApprovalSupersession")
  publications   KnowledgePublication[]

  @@unique([propertyId, purpose, scopeHash, decision, policyVersion])
  @@unique([propertyId, id])
}

model KnowledgePublication {
  id                    String                      @id @default(cuid())
  propertyId            String
  audience              KnowledgeAudience
  manifestHash          String
  policyVersion         String
  evidencePolicyVersion String
  approvalId            String
  state                 PublicationState            @default(CANDIDATE)
  sealedAt              DateTime?
  membershipClosedAt    DateTime?
  revokedAt             DateTime?
  createdAt             DateTime                    @default(now())
  approval              KnowledgeApprovalEvidence   @relation(fields: [propertyId, approvalId], references: [propertyId, id], onDelete: Restrict)
  claims                KnowledgePublicationClaim[]
  pointers              KnowledgeServingPointer[]
  answerAudits          KnowledgeAnswerAudit[]
  certificationRuns     KnowledgeCertificationRun[]

  @@unique([propertyId, audience, manifestHash, policyVersion])
  @@unique([propertyId, audience, id])
  @@unique([propertyId, id])
}

model KnowledgePublicationClaim {
  id               String                 @id @default(cuid())
  propertyId       String
  publicationId    String
  claimIdentityId  String
  entryId          String
  sealManifestHash String
  createdAt        DateTime               @default(now())
  publication      KnowledgePublication   @relation(fields: [propertyId, publicationId], references: [propertyId, id], onDelete: Restrict)
  claimIdentity    KnowledgeClaimIdentity @relation(fields: [propertyId, claimIdentityId], references: [propertyId, id], onDelete: Restrict)
  entry            KnowledgeEntry         @relation(fields: [propertyId, claimIdentityId, entryId, sealManifestHash], references: [propertyId, claimIdentityId, id, sealManifestHash], onDelete: Restrict)

  @@unique([propertyId, publicationId, claimIdentityId])
  @@unique([propertyId, publicationId, entryId])
}

model KnowledgeServingPointer {
  id                    String               @id @default(cuid())
  propertyId            String
  audience              KnowledgeAudience
  publicationId         String
  pointerGeneration     BigInt               @default(1)
  eligibilityGeneration BigInt               @default(1)
  updatedBy             String
  updatedAt             DateTime             @updatedAt
  publication           KnowledgePublication @relation(fields: [propertyId, audience, publicationId], references: [propertyId, audience, id], onDelete: Restrict)

  @@unique([propertyId, audience])
}

model KnowledgePolicyVersion {
  id                    String                      @id @default(cuid())
  propertyId            String
  property              Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  version               Int
  mode                  KnowledgePolicyMode
  owner                 String
  expiresAt             DateTime?
  publicationAutomation Boolean                     @default(false)
  freshnessRules        Json
  evidenceRules         Json
  policyHash            String
  createdAt             DateTime                    @default(now())
  currentFor            PropertyIntelligencePolicy?
  certificationRuns     KnowledgeCertificationRun[]

  @@unique([propertyId, version])
  @@unique([propertyId, id])
}

model PropertyIntelligencePolicy {
  propertyId             String                 @id
  currentPolicyVersionId String
  eligibilityGeneration  BigInt                 @default(1)
  reviewRequired         Boolean                @default(true)
  updatedAt              DateTime               @updatedAt
  property               Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  currentPolicy          KnowledgePolicyVersion @relation(fields: [propertyId, currentPolicyVersionId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, currentPolicyVersionId])
}

model KnowledgePreviewSession {
  id                  String                  @id @default(cuid())
  organizationId      String
  propertyId          String
  createdByMemberId   String
  accessScope         Json
  accessScopeHash     String
  candidateGeneration BigInt
  state               PreviewState            @default(ACTIVE)
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime                @default(now())
  property            Property                @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member              OrganizationMember      @relation(fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict)
  claims              KnowledgePreviewClaim[]

  @@unique([propertyId, id])
  @@unique([propertyId, id, candidateGeneration])
}

model KnowledgePreviewClaim {
  id                  String                  @id @default(cuid())
  propertyId          String
  previewSessionId    String
  entryId             String
  candidateGeneration BigInt
  createdAt           DateTime                @default(now())
  session             KnowledgePreviewSession @relation(fields: [propertyId, previewSessionId, candidateGeneration], references: [propertyId, id, candidateGeneration], onDelete: Cascade)
  entry               KnowledgeEntry          @relation(fields: [propertyId, entryId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, previewSessionId, entryId])
}

model KnowledgeGuestSession {
  id               String                     @id @default(cuid())
  propertyId       String
  conversationId   String
  sessionHash      String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime                   @default(now())
  property         Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversation     Conversation               @relation(fields: [propertyId, conversationId], references: [propertyId, id], onDelete: Restrict)
  answerAudits     KnowledgeAnswerAudit[]
  handoverRequests KnowledgeHandoverRequest[]

  @@unique([propertyId, sessionHash])
  @@unique([propertyId, conversationId, id])
}

model KnowledgeRevisionEvent {
  id             String             @id @default(cuid())
  propertyId     String
  entryId        String
  eventType      KnowledgeEventType
  relatedEntryId String?
  reason         String             @db.Text
  actorId        String
  occurredAt     DateTime           @default(now())
  entry          KnowledgeEntry     @relation("RevisionEventEntry", fields: [propertyId, entryId], references: [propertyId, id], onDelete: Restrict)
  relatedEntry   KnowledgeEntry?    @relation("RevisionEventRelated", fields: [propertyId, relatedEntryId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, entryId, eventType, relatedEntryId])
  @@unique([propertyId, id])
}

model KnowledgeAnswerAudit {
  id                    String                   @id @default(cuid())
  propertyId            String
  conversationId        String
  guestSessionId        String
  publicationId         String
  pointerGeneration     BigInt
  eligibilityGeneration BigInt
  selectedManifest      Json
  selectedManifestHash  String
  validationResult      Json
  deliveryState         AnswerDeliveryState      @default(PENDING)
  createdAt             DateTime                 @default(now())
  property              Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversation          Conversation             @relation(fields: [propertyId, conversationId], references: [propertyId, id], onDelete: Restrict)
  guestSession          KnowledgeGuestSession    @relation(fields: [propertyId, conversationId, guestSessionId], references: [propertyId, conversationId, id], onDelete: Restrict)
  publication           KnowledgePublication     @relation(fields: [propertyId, publicationId], references: [propertyId, id], onDelete: Restrict)
  outcomes              KnowledgeAnswerOutcome[]

  @@unique([propertyId, id])
  @@index([propertyId, conversationId, createdAt])
}

model KnowledgeAnswerOutcome {
  id            String               @id @default(cuid())
  propertyId    String
  answerAuditId String
  deliveryKey   String
  state         AnswerDeliveryState
  detail        Json?
  occurredAt    DateTime             @default(now())
  answerAudit   KnowledgeAnswerAudit @relation(fields: [propertyId, answerAuditId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, answerAuditId, deliveryKey])
}

model KnowledgeHandoverRequest {
  id             String                   @id @default(cuid())
  propertyId     String
  conversationId String
  guestSessionId String
  requestHash    String
  recordedAt     DateTime                 @default(now())
  property       Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversation   Conversation             @relation(fields: [propertyId, conversationId], references: [propertyId, id], onDelete: Restrict)
  guestSession   KnowledgeGuestSession    @relation(fields: [propertyId, conversationId, guestSessionId], references: [propertyId, conversationId, id], onDelete: Restrict)
  events         KnowledgeHandoverEvent[]

  @@unique([propertyId, requestHash])
  @@unique([propertyId, id])
}

model KnowledgeHandoverEvent {
  id            String                   @id @default(cuid())
  propertyId    String
  requestId     String
  state         HandoverState
  sequence      Int
  attemptNumber Int?
  provider      String?
  deliveryId    String?
  errorCode     String?
  actorId       String
  occurredAt    DateTime                 @default(now())
  request       KnowledgeHandoverRequest @relation(fields: [propertyId, requestId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, requestId, sequence])
  @@unique([provider, deliveryId])
}

model KnowledgeOutboxEvent {
  id             String      @id @default(cuid())
  propertyId     String
  operationKey   String
  eventType      String
  schemaVersion  Int
  payload        Json
  state          OutboxState @default(PENDING)
  availableAt    DateTime    @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attempts       Int         @default(0)
  dispatchedAt   DateTime?
  createdAt      DateTime    @default(now())

  @@unique([propertyId, operationKey, eventType, schemaVersion])
  @@unique([propertyId, id])
}

model AutomationJobAttempt {
  id            String          @id @default(cuid())
  propertyId    String
  jobId         String
  attemptNumber Int
  workerId      String
  fencingToken  BigInt
  state         JobAttemptState @default(RUNNING)
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  errorCode     String?
  job           AutomationJob   @relation(fields: [propertyId, jobId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, jobId, attemptNumber])
  @@unique([propertyId, jobId, fencingToken])
}

model KnowledgeCertificationRun {
  id               String                 @id @default(cuid())
  propertyId       String
  policyVersionId  String
  publicationId    String?
  suiteVersion     String
  caseManifestHash String
  resultManifest   Json
  resultHash       String
  passed           Boolean
  executedAt       DateTime
  property         Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  policyVersion    KnowledgePolicyVersion @relation(fields: [propertyId, policyVersionId], references: [propertyId, id], onDelete: Restrict)
  publication      KnowledgePublication?  @relation(fields: [propertyId, publicationId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, policyVersionId, publicationId, suiteVersion, caseManifestHash])
  @@unique([propertyId, id])
}

model KnowledgeRetentionDecision {
  id                String                   @id @default(cuid())
  propertyId        String
  objectReferenceId String
  state             RetentionState           @default(RETAIN)
  policyVersion     String
  legalHold         Boolean                  @default(false)
  decidedBy         String
  reason            String                   @db.Text
  decidedAt         DateTime                 @default(now())
  property          Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  objectReference   KnowledgeObjectReference @relation(fields: [propertyId, objectReferenceId], references: [propertyId, id], onDelete: Restrict)

  @@unique([propertyId, objectReferenceId, policyVersion, state])
  @@unique([propertyId, id])
}

model KnowledgeMigrationDecision {
  id                String         @id
  propertyId        String
  legacyEntryId     String
  batchId           String
  decision          String
  reasonCode        String
  proposedStableKey String?
  sourceHash        String
  createdAt         DateTime       @default(now())
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  legacyEntry       KnowledgeEntry @relation(fields: [propertyId, legacyEntryId], references: [propertyId, id], onDelete: Restrict)

  @@unique([batchId, legacyEntryId])
  @@unique([propertyId, id])
}

model KnowledgeMigrationArtifactDecision {
  id             String   @id
  propertyId     String
  batchId        String
  artifactType   String
  legacyId       String
  sourcePathHash String?
  contentHash    String
  decision       String
  reasonCode     String
  sourceId       String?
  objectId       String?
  createdAt      DateTime @default(now())
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([batchId, artifactType, legacyId])
  @@unique([propertyId, id])
}

model KnowledgeRuntimePrincipalGrant {
  id           String    @id
  propertyId   String
  principalId  String
  databaseRole String
  purpose      String
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, principalId, databaseRole, purpose])
  @@unique([propertyId, id])
}

datasource db {
  provider = "postgresql"
}

enum LeadLanguage {
  HI
  EN
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  BOOKED
  LOST
}

enum MessageSender {
  GUEST
  AGENT
  AI
}

enum AssetType {
  IMAGE
  VIDEO_LINK
  PDF
  INVOICE_LINK
  PAYMENT_LINK
  BROCHURE_LINK
  DOCUMENT_LINK
}

enum AssetCategory {
  ROOM
  EXPERIENCE
  PROPERTY
  WEDDING
  DINING
  BROCHURE
  INVOICE
  PAYMENT
  OTHER
}

enum ChannelKind {
  WHATSAPP
  WEBSITE
  EMAIL
  INSTAGRAM
  API
  VOICE
}

enum ChannelConnectionStatus {
  DRAFT
  CONNECTING
  CONNECTED
  DEGRADED
  DISABLED
  ERROR
}

enum ParticipantKind {
  CUSTOMER
  HUMAN
  BOT
  SYSTEM
}

enum ConversationStatus {
  OPEN
  BOT_ACTIVE
  HUMAN_OWNED
  RESOLVED
  CLOSED
}

enum NeutralMessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum BotCategory {
  BUSINESS_AI
  PINGBOOK
  FLOWCART
  STAY
  RESTAURANT
  REAL_ESTATE
  EDUCATION
  CUSTOM
}

enum BotOperatingMode {
  ANSWER_ONLY
  LEAD_CAPTURE
  APPROVED_ACTIONS
  HUMAN_APPROVAL
}

// AI Readiness is an internal, evidence-led product line. These enums are
// deliberately separate from bot lifecycle state so a readiness observation
// can never make a bot live or change customer-facing behaviour.
enum ReadinessScanStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ReadinessEvidenceStatus {
  PASS
  FAIL
  INSUFFICIENT_EVIDENCE
  NOT_APPLICABLE
}

enum ReadinessIssueStatus {
  DETECTED
  REVIEW_REQUIRED
  APPROVED
  DECLINED
  NOT_APPLICABLE
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
}

enum ReadinessDeliveryRoute {
  AIFROGI_MANAGED
  AGENCY_HANDOFF
  CLIENT_GUIDANCE
}

enum KnowledgeSourceType {
  WEBSITE
  PDF
  SPREADSHEET
  FORM
  OWNER_CORRECTION
  CONNECTOR
}

enum KnowledgeSourceState {
  DRAFT
  AUTHORIZED
  PAUSED
  REVOKED
  ARCHIVED
}

enum KnowledgeAudience {
  PUBLIC
  STAFF
  RESTRICTED
}

enum ClaimRevisionState {
  DRAFT
  SEALED
}

enum ClaimVerificationStatus {
  SUPPORTED
  PARTIAL
  CONTRADICTED
  UNSUPPORTED
}

enum CaptureState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum KnowledgeObjectState {
  STAGED
  USABLE
  QUARANTINED
  RETAINED_ORPHAN
}

enum ApprovalPurpose {
  PREVIEW_ACKNOWLEDGEMENT
  PUBLICATION_AUTHORIZATION
  PUBLICATION_REVOCATION
  SOURCE_CORRECTION
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVOKED
}

enum PublicationState {
  CANDIDATE
  SEALED
  REVOKED
}

enum PreviewState {
  ACTIVE
  EXPIRED
  REVOKED
}

enum KnowledgePolicyMode {
  LEGACY
  CLAIMS_ONLY
  BLOCKED
}

enum KnowledgeEventType {
  SUPERSEDED
  WITHDRAWN
  AUTHORITY_REVOKED
}

enum OutboxState {
  PENDING
  LEASED
  DISPATCHED
  DEAD_LETTER
}

enum JobAttemptState {
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
}

enum AnswerDeliveryState {
  PENDING
  DELIVERED
  SUPPRESSED
  FAILED
  HANDOVER
}

enum HandoverState {
  RECORDED
  QUEUED
  PROVIDER_ACCEPTED
  STAFF_ACKNOWLEDGED
  RESOLVED
  REOPENED
  CANCELED
}

enum RetentionState {
  RETAIN
  DISPOSAL_PROPOSED
  DISPOSAL_APPROVED
  DISPOSED
}

model Property {
  id                       String                       @id @default(cuid())
  organizationId           String?
  organization             Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String                       @unique
  city                     String?
  state                    String?
  timezone                 String                       @default("Asia/Kolkata")
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  websiteConsentEnforcedAt DateTime?
  leads                    Lead[]
  metrics                  MetricDaily[]
  campaigns                Campaign[]
  automationJobs           AutomationJob[]
  assets                   Asset[]
  whatsappIntegration      WhatsAppIntegration?
  appointmentTenants       AppointmentTenant[]
  commerceTenants          CommerceTenant[]
  knowledgeDocuments       KnowledgeDocument[]
  knowledgeEntries         KnowledgeEntry[]
  knowledgeGaps            KnowledgeGap[]
  knowledgePreviews        KnowledgePreview[]
  knowledgeFlags           KnowledgeAnswerFlag[]
  channelConnections       ChannelConnection[]
  participants             Participant[]
