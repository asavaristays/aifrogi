enum WebsiteSourceConsentStatus {
  TRIAL_AUTHORIZED
  POST_TRIAL_APPROVED
  REVOKED
}

enum WebsiteSourceApprovalMethod {
  EMAIL
  SIGNED_LETTER
}

model WebsiteSourceConsent {
  id                    String                       @id @default(cuid())
  propertyId            String
  property              Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceUrl             String?                      @db.Text
  sourceUrlHash         String?
  termsVersion          String
  status                WebsiteSourceConsentStatus   @default(TRIAL_AUTHORIZED)
  trialAuthorizedAt     DateTime
  trialExpiresAt        DateTime
  acceptedByEmail       String
  acceptedIpHash        String?
  postTrialMethod       WebsiteSourceApprovalMethod?
  postTrialApprovedBy   String?
  postTrialApprovedAt   DateTime?
  approvalEvidenceRef   String?
  revokedAt             DateTime?
  revokedBy             String?
  revocationReason      String?                      @db.Text
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  sourceType            KnowledgeSourceType          @default(WEBSITE)
  canonicalIdentity     String?                      @db.Text
  canonicalIdentityHash String?
  sourceId              String?
  authorityScope        Json?
  audienceCeiling       KnowledgeAudience            @default(RESTRICTED)
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  source                KnowledgeSource?             @relation(fields: [propertyId, sourceId], references: [propertyId, id], onDelete: Restrict)
  sourceRevisions       KnowledgeSourceRevision[]

  @@unique([propertyId, sourceUrlHash])
  @@unique([propertyId, sourceType, canonicalIdentityHash])
  @@unique([propertyId, id])
  @@index([propertyId, status, trialExpiresAt])
}

/**
 * Durable, internal-only scan request and execution record. A scan is never
 * created by a public bot route; its state is advanced by a controlled worker.
 */
model ReadinessScan {
  id                 String                  @id @default(cuid())
  organizationId     String
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rubricVersion      String
  sourceUrl          String
  status             ReadinessScanStatus     @default(QUEUED)
  idempotencyKey     String                  @unique
  requestPayload     Json?
  result             Json?
  requestedBy        String
  attemptCount       Int                     @default(0)
  maxAttempts        Int                     @default(3)
  nextRunAt          DateTime                @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  leaseExpiresAt     DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  canceledBy         String?
  cancellationReason String?                 @db.Text
  lastError          String?                 @db.Text
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  evidence           ReadinessEvidence[]
  issues             ReadinessIssue[]
  verificationAfter  ReadinessVerification[] @relation("ReadinessVerificationAfter")
  verificationBefore ReadinessVerification[] @relation("ReadinessVerificationBefore")

  @@index([organizationId, status, nextRunAt])
  @@index([propertyId, createdAt])
  @@index([status, leaseExpiresAt])
}

/**
 * Immutable observation captured by one scan/check; scan text is evidence, never tenant authority.
 */
model ReadinessEvidence {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanId              String
  scan                ReadinessScan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  pillar              String
  checkKey            String
  status              ReadinessEvidenceStatus
  observedValue       Json?
  canonicalComparison Json?
  sourceUrl           String?
  capturedAt          DateTime                @default(now())
  evidenceHash        String
  createdAt           DateTime                @default(now())
  issue               ReadinessIssue?

  @@unique([scanId, checkKey])
  @@index([organizationId, pillar, status])
}

model ReadinessIssue {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanId          String
  scan            ReadinessScan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  evidenceId      String?              @unique
  evidence        ReadinessEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  pillar          String
  checkKey        String
  severity        String
  status          ReadinessIssueStatus @default(DETECTED)
  summary         String               @db.Text
  proposedRemedy  String?              @db.Text
  remediationType String?
  reviewedBy      String?
  reviewedAt      DateTime?
  decisionReason  String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  workItems       ReadinessWorkItem[]

  @@index([organizationId, status, severity])
  @@index([scanId, pillar])
}

model ReadinessWorkItem {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  issueId             String
  issue               ReadinessIssue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  deliveryRoute       ReadinessDeliveryRoute
  owner               String
  dueAt               DateTime?
  acceptanceCriterion String                 @db.Text
  status              String                 @default("OPEN")
  approvedBy          String?
  approvedAt          DateTime?
  completedBy         String?
  completedAt         DateTime?
  completionRecord    Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  verification        ReadinessVerification?

  @@index([organizationId, status, dueAt])
  @@index([propertyId, createdAt])
  @@index([issueId])
}

model ReadinessVerification {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  workItemId     String            @unique
  workItem       ReadinessWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  beforeScanId   String
  beforeScan     ReadinessScan     @relation("ReadinessVerificationBefore", fields: [beforeScanId], references: [id], onDelete: Restrict)
  afterScanId    String
  afterScan      ReadinessScan     @relation("ReadinessVerificationAfter", fields: [afterScanId], references: [id], onDelete: Restrict)
  rubricVersion  String
  status         String
  evidenceRefs   Json
  verifiedBy     String
  verifiedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([organizationId, verifiedAt])
  @@index([propertyId, rubricVersion])
}

model KnowledgeDocument {
  id              String           @id @default(cuid())
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  content         Bytes
  extractedText   String           @db.Text
  status          String           @default("PENDING")
  conflictSummary String?          @db.Text
  uploadedBy      String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         KnowledgeEntry[]

  @@index([propertyId, status])
}

model KnowledgeEntry {
  id                    String                             @id @default(cuid())
  propertyId            String
  property              Property                           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documentId            String?
  document              KnowledgeDocument?                 @relation(fields: [documentId], references: [id], onDelete: SetNull)
  question              String                             @db.Text
  answer                String                             @db.Text
  category              String                             @default("General")
  status                String                             @default("DRAFT")
  conflictSummary       String?                            @db.Text
  claimKey              String?
  claimType             String                             @default("FACT")
  valueType             String                             @default("TEXT")
  currency              String?
  effectiveAt           DateTime?
  expiresAt             DateTime?
  refreshDays           Int                                @default(90)
  reliability           String                             @default("CLIENT_CONFIRMED")
  authorityLevel        String                             @default("CLIENT_APPROVED_STRUCTURED")
  version               Int                                @default(1)
  supersedesId          String?
  supersedes            KnowledgeEntry?                    @relation("KnowledgeSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy          KnowledgeEntry[]                   @relation("KnowledgeSupersession")
  validationStatus      String                             @default("PENDING")
  validationErrors      String[]                           @default([])
  conflictStatus        String                             @default("CLEAR")
  fieldApprovedBy       String?
  fieldApprovedAt       DateTime?
  previewApprovedBy     String?
  previewApprovedAt     DateTime?
  publishedAt           DateTime?
  pausedAt              DateTime?
  pauseReason           String?
  lastConfirmedAt       DateTime?
  createdBy             String
  approvedBy            String?
  approvedAt            DateTime?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt
  resolvedGaps          KnowledgeGap[]
  previews              KnowledgePreview[]
  answerFlags           KnowledgeAnswerFlag[]
  claimIdentityId       String?
  claimIdentity         KnowledgeClaimIdentity?            @relation(fields: [propertyId, claimIdentityId], references: [propertyId, id], onDelete: Restrict)
  revisionNumber        Int?
  normalizedValue       Json?
  valueHash             String?
  quoteText             String?                            @db.Text
  audience              KnowledgeAudience?
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  verificationStatus    ClaimVerificationStatus?
  revisionState         ClaimRevisionState                 @default(DRAFT)
  requiredComponents    String[]                           @default([])
  sealManifestHash      String?
  sealPolicyVersion     String?
  sealedAt              DateTime?
  sealedBy              String?
  evidence              KnowledgeClaimEvidence[]
  evidenceBindings      KnowledgeRevisionEvidenceBinding[]
  revisionEvents        KnowledgeRevisionEvent[]           @relation("RevisionEventEntry")
  relatedRevisionEvents KnowledgeRevisionEvent[]           @relation("RevisionEventRelated")
  lowerConflicts        KnowledgeClaimConflict[]           @relation("ConflictLower")
  higherConflicts       KnowledgeClaimConflict[]           @relation("ConflictHigher")
  migrationDecisions    KnowledgeMigrationDecision[]
  publicationClaims     KnowledgePublicationClaim[]
  previewClaims         KnowledgePreviewClaim[]

  @@unique([propertyId, id])
  @@unique([propertyId, claimIdentityId, revisionNumber])
  @@unique([propertyId, claimIdentityId, id, sealManifestHash])
  @@index([propertyId, status])
  @@index([propertyId, claimKey, version])
  @@index([propertyId, expiresAt, status])
  @@index([supersedesId])
  @@index([documentId])
  @@index([propertyId, claimIdentityId, sealedAt])
}

model KnowledgePreview {
